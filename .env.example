# Copy to .env and fill in — compose then picks the values up automatically.
# docker compose up fails fast while the two domains are unset.

# Required, no defaults.
DNS_DOMAIN=
TAILSCALE_DOMAIN=

# Optional.
TS_HOSTNAME=coredns-test
# DNS listen port (loopback/LAN and tailnet listeners).
DNS_PORT=53
# Upstream resolver(s) for names outside the tailnet, space separated:
# resolver addresses (host[:port], [ipv6]:port) and/or resolv.conf paths.
# Unset means /etc/resolv.conf of the machine running the server — inside a
# container that is the runtime's own resolver (podman's aardvark-dns on the
# network gateway, Docker's embedded one, systemd-resolved's 127.0.0.53),
# which may not answer. compose defaults to the resolvers below.
# Never point this at this server itself: that is a DNS loop.
# UPSTREAM_DNS="1.1.1.1:53 8.8.8.8:53"
# Embedded tsnet node: create a key at https://login.tailscale.com/admin/settings/keys
# When set, the server is also served on the node's tailnet IPs (A and AAAA).
TS_AUTHKEY=
